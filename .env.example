# BoundaryLens — local demo configuration only. All values are fictional.
# Demo identity passwords (local, fictional). The scanner reads these; the demo app
# reads the LEDGERLY_* variants. Keep them in sync (compose.yaml does this for you).
BL_ALICE_PASSWORD=alice-local-demo
BL_BOB_PASSWORD=bob-local-demo
BL_ADMIN_PASSWORD=admin-local-demo
LEDGERLY_ALICE_PASSWORD=alice-local-demo
LEDGERLY_BOB_PASSWORD=bob-local-demo
LEDGERLY_ADMIN_PASSWORD=admin-local-demo

# Scanner service
BL_HOST=127.0.0.1
BL_PORT=8080
BL_REQUIRE_ACK=true
# Demo target origins (defaults match compose.yaml and run_local.sh)
BL_DEMO_VULNERABLE_ORIGIN=http://127.0.0.1:8081
BL_DEMO_FIXED_ORIGIN=http://127.0.0.1:8082
# Non-loopback origins must be listed here explicitly (comma-separated hostnames).
BL_ALLOWED_HOSTS=

# Automated-scan CLI (boundarylens.yaml) target override. Defaults to the vulnerable demo.
BL_TARGET_ORIGIN=http://127.0.0.1:8081
# Optional bearer/JWT identity example (not used by the demo; referenced by boundarylens.yaml):
# SVC_TOKEN=
